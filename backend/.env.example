GIO_DEBUG=1
GIO_SECRET_KEY=cambie-esta-clave-por-una-aleatoria-de-50-caracteres
GIO_ALLOWED_HOSTS=localhost,127.0.0.1
GIO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

GIO_DB_ENGINE=postgresql
GIO_DB_NAME=sistema_gio
GIO_DB_USER=postgres
GIO_DB_PASSWORD=
GIO_DB_HOST=localhost
GIO_DB_PORT=5432

# Carpeta de intercambio con SISA (rutas relativas a backend/). Puede ser una carpeta de red;
# véase docs/carpeta-compartida-sisa.md.
GIO_PRIVATE_DATA_DIR=../private_data
# Opcional: reporte (o carpeta) que la computadora de SISA deja en su carpeta compartida. GIO lo
# copia a sisa_imports cuando cambia y no toca el original.
# GIO_SISA_ORIGEN=\\PC-SISA\reportes\Reporte_Completo.xls
# Opcional: entrada y retorno en otra carpeta, p. ej. compartida por la computadora de SISA.
# GIO_SISA_IMPORTS_DIR=\\PC-SISA\GIO_Reportes
# GIO_SISA_EXPORTS_DIR=\\PC-SISA\GIO_Retorno
# Segundos sin cambios antes de leer un reporte (evita leer uno que se sigue copiando).
GIO_SISA_ESPERA_SEGUNDOS=60
GIO_MEDIA_ROOT=media

# Correo para recuperar contraseñas: pida a sistemas el servidor SMTP y una cuenta para enviar.
# Sin GIO_EMAIL_HOST, el correo solo se muestra en la consola del servidor.
# GIO_EMAIL_HOST=smtp.empresa.com.mx
# GIO_EMAIL_PORT=587
# GIO_EMAIL_USUARIO=gio.avisos@empresa.com.mx
# GIO_EMAIL_PASSWORD=
# GIO_EMAIL_REMITENTE=Sistema GIO <gio.avisos@empresa.com.mx>
# Dirección con la que los técnicos abren GIO; va en el enlace del correo.
# GIO_URL_PUBLICA=https://gio.empresa.com.mx
GIO_RECUPERACION_MINUTOS=60

GIO_JWT_ACCESS_HORAS=8
GIO_JWT_REFRESH_DIAS=1
GIO_PAGE_SIZE=50

GIO_EVIDENCIA_MAX_BYTES=1048576
GIO_EVIDENCIA_MAX_POR_FOLIO=12
GIO_DILACION_UMBRAL_DIAS=5
GIO_DILACION_UMBRAL_CRITICO_DIAS=10
